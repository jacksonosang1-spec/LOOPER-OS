rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: leads
    // Document ID: random string
    // Fields:
    //   - companyName: string (required)
    //   - websiteUrl: string (required)
    //   - contactName: string
    //   - email: string
    //   - emailStatus: string (verified, unverified, unknown)
    //   - status: string
    //   - score: number
    //   - priority: string
    //   - websiteStatus: string
    //   - painPoints: list
    //   - lastActionDate: string
    //   - createdAt: string
    //   - openedAt: string
    //   - isOpened: bool
    //   - activityHistory: list of objects
    //   - uid: string (required, owner)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function isAdmin() {
      return isAuthenticated() &&
        ((exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
          (request.auth.token.email == "jacksonosang1@gmail.com" && request.auth.token.email_verified == true));
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidActivityLog(log) {
      return log.id is string &&
             log.type in ['Analysis', 'Outreach', 'Status Change', 'Note'] &&
             log.content is string &&
             log.timestamp is string;
    }

    function isValidLead(data) {
      return data.companyName is string && data.companyName.size() > 0 && data.companyName.size() < 200 &&
             data.websiteUrl is string && data.websiteUrl.size() > 0 && data.websiteUrl.size() < 500 &&
             data.uid is string && data.uid == request.auth.uid &&
             (!('score' in data) || data.score is number) &&
             (!('email' in data) || data.email is string) &&
             (!('emailStatus' in data) || data.emailStatus in ['verified', 'unverified', 'unknown']) &&
             (!('activityHistory' in data) || (data.activityHistory is list && data.activityHistory.size() < 100));
    }

    // ===============================================================
    // Rules
    // ===============================================================

    function isAnonymous() {
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isTrackingUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['isOpened', 'openedAt', 'isClicked', 'clickedAt', 'activityHistory', 'lastActionDate', 'replies', 'status', 'priority', 'email']);
    }

    match /leads/{leadId} {
      // Allow anyone to read leads (needed for tracking and diagnostics if backend is unauth)
      // In production, you would restrict this more.
      allow get, list: if true; 
      
      // Allow users to create leads (non-anonymous)
      allow create: if isAuthenticated() && !isAnonymous() &&
                      hasRequiredFields(['companyName', 'websiteUrl', 'uid']) &&
                      isValidLead(request.resource.data);
      
      // Allow authenticated owners or unauthenticated tracking updates
      allow update: if (isDocOwner() || isAdmin() || isTrackingUpdate()) && 
                      request.resource.data.uid == resource.data.uid;
      
      // Only allow owners or admins to delete
      allow delete: if isAdmin() || isDocOwner();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.role == 'user';
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
    }
    
    // Default deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
