{
  "entities": {
    "Lead": {
      "title": "Lead",
      "description": "A potential client lead",
      "type": "object",
      "properties": {
        "companyName": { "type": "string" },
        "websiteUrl": { "type": "string" },
        "contactName": { "type": "string" },
        "email": { "type": "string" },
        "emailStatus": { "type": "string", "enum": ["verified", "unverified", "unknown"] },
        "status": { "type": "string" },
        "score": { "type": "number" },
        "priority": { "type": "string" },
        "websiteStatus": { "type": "string" },
        "painPoints": { "type": "array", "items": { "type": "string" } },
        "lastActionDate": { "type": "string" },
        "createdAt": { "type": "string" },
        "openedAt": { "type": "string" },
        "isOpened": { "type": "boolean" },
        "activityHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string", "enum": ["Analysis", "Outreach", "Status Change", "Note"] },
              "content": { "type": "string" },
              "timestamp": { "type": "string" }
            }
          }
        },
        "replies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "from": { "type": "string" },
              "content": { "type": "string" },
              "snippet": { "type": "string" },
              "timestamp": { "type": "string" },
              "isInterested": { "type": "boolean" },
              "followUpDraft": { "type": "string" }
            }
          }
        },
        "uid": { "type": "string" }
      },
      "required": ["companyName", "websiteUrl", "uid"]
    }
  },
  "firestore": {
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Collection of leads"
    }
  }
}
