# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EMAIL_VERIFICATION_API_KEY: Required for premium email verification (Abstract API).
# Get your free key from https://www.abstractapi.com/email-verification-api
# If not provided, the app will fallback to DNS-based verification.
EMAIL_VERIFICATION_API_KEY=

# VERIFALIA_APP_SID and VERIFALIA_APP_KEY: Secondary fallback for email verification.
# Get your credentials from https://verifalia.com/
VERIFALIA_APP_SID=
VERIFALIA_APP_KEY=

# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET: Required for Gmail API integration.
# Get your credentials from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Firebase Configuration: Required for database and authentication.
# These should be set in the AI Studio Settings menu.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
